DATA_DIR=./data
LOG_LEVEL=info
BROWSER_HEADED=true
# Which browser to drive. Your own Chrome passes Instagram's security check; Playwright's
# bundled Chromium often cannot, on macOS especially. Empty = the bundled one.
BROWSER_CHANNEL=chrome
# Keep one browser profile between runs, so Instagram meets the same device every time.
BROWSER_KEEP_PROFILE=true
NAVIGATION_TIMEOUT_MS=30000
LOGIN_TIMEOUT_MS=600000
DISCOVERY_SCROLL_DELAY_MS=2500
DISCOVERY_MAX_IDLE_SCROLLS=5
FRAME_INTERVAL=1
# Newest posts (photos and Reels alike) to find per account; "all" walks the whole profile.
POST_LIMIT=all
COMMENT_LIMIT=100
# FFmpeg is downloaded by npm install; set FFMPEG_PATH only to use another binary.
# FFMPEG_PATH=
# Transcription (optional): groq (free tier), openai (paid), or custom (any OpenAI-compatible server, e.g. local Whisper).
TRANSCRIPTION_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
# TRANSCRIPTION_MODEL=           defaults: groq whisper-large-v3-turbo, openai whisper-1
# TRANSCRIPTION_BASE_URL=        custom only, e.g. http://localhost:8000/v1
# TRANSCRIPTION_API_KEY=         overrides the provider's key variable
COMMENTS_MAX_ROUNDS=60
COMMENTS_MAX_IDLE_ROUNDS=3
COMMENTS_MAX_SECONDS=300
COMMENTS_ROUND_DELAY_MS=2500
